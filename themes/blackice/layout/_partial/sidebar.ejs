<aside class="sidebar" id="sidebar">
  <div class="profile-card">
    <img class="avatar" src="<%- url_for(theme.profile.avatar) %>" alt="<%= theme.profile.name %>">
    <h2 class="profile-name"><%= theme.profile.name %></h2>
    <p class="profile-tagline"><%= theme.profile.tagline %></p>

    <div class="social-links">
      <% if (theme.social.github) { %>
      <a href="<%= theme.social.github %>" target="_blank" rel="noopener noreferrer" aria-label="GitHub" title="GitHub">
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
          <circle cx="12" cy="13" r="8" fill="none" stroke="currentColor" stroke-width="1.8"/>
          <path d="M7 8 L9.5 5.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
          <path d="M17 8 L14.5 5.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
          <circle cx="9" cy="12.5" r="1.1" fill="currentColor"/>
          <circle cx="15" cy="12.5" r="1.1" fill="currentColor"/>
        </svg>
      </a>
      <% } %>

      <% if (theme.social.x) { %>
      <a href="<%= theme.social.x %>" target="_blank" rel="noopener noreferrer" aria-label="X (Twitter)" title="X">
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
          <circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="1.6"/>
          <line x1="8" y1="8" x2="16" y2="16" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
          <line x1="16" y1="8" x2="8" y2="16" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
        </svg>
      </a>
      <% } %>

      <% if (theme.social.linkedin) { %>
      <a href="<%= theme.social.linkedin %>" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" title="LinkedIn">
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
          <rect x="3" y="3" width="18" height="18" rx="4" fill="none" stroke="currentColor" stroke-width="1.6"/>
          <text x="12" y="16.5" font-family="Arial, sans-serif" font-size="10" font-weight="700" fill="currentColor" text-anchor="middle">in</text>
        </svg>
      </a>
      <% } %>

      <% if (theme.social.instagram) { %>
      <a href="<%= theme.social.instagram %>" target="_blank" rel="noopener noreferrer" aria-label="Instagram" title="Instagram">
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
          <rect x="3.5" y="3.5" width="17" height="17" rx="5" fill="none" stroke="currentColor" stroke-width="1.6"/>
          <circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="1.6"/>
          <circle cx="16.7" cy="7.3" r="1" fill="currentColor"/>
        </svg>
      </a>
      <% } %>
    </div>
  </div>
</aside>
