<article class="post">
  <header class="post-header">
    <h1 class="post-title"><%= page.title %></h1>
    <div class="post-meta">
      <time datetime="<%= date_xml(page.date) %>">published <%= date(page.date, 'YYYY-MM-DD') %></time>
      <% if (page.updated && page.updated.valueOf() !== page.date.valueOf()) { %>
        <span>&middot; updated <%= date(page.updated, 'YYYY-MM-DD') %></span>
      <% } %>
      <% if (page.categories && page.categories.length) { %>
        <% page.categories.forEach(function(cat){ %>
          <a class="pill" href="<%- url_for(cat.path) %>"><%= cat.name %></a>
        <% }) %>
      <% } %>
    </div>
  </header>

  <div class="post-content">
    <%- page.content %>
  </div>

  <% if (page.tags && page.tags.length) { %>
  <div class="post-card-tags post-tags">
    <% page.tags.forEach(function(tag){ %>
      <a class="tag" href="<%- url_for(tag.path) %>">#<%= tag.name %></a>
    <% }) %>
  </div>
  <% } %>

  <nav class="post-pager">
    <% if (page.prev) { %><a class="pager-link" href="<%- url_for(page.prev.path) %>">&larr; <%= page.prev.title %></a><% } else { %><span></span><% } %>
    <% if (page.next) { %><a class="pager-link" href="<%- url_for(page.next.path) %>"><%= page.next.title %> &rarr;</a><% } %>
  </nav>
</article>
