<!DOCTYPE html>
<html lang="<%= config.language || 'en' %>" data-theme="dark">
<head>
<%- partial('_partial/head') %>
</head>
<body>
  <div class="bg-layer" id="bgLayer" style="background-image: url('<%- url_for(theme.background.image) %>');"></div>
  <div class="bg-overlay" id="bgOverlay"></div>

  <%- partial('_partial/nav') %>

  <div class="page-shell">
    <%- partial('_partial/sidebar') %>
    <main class="content">
      <%- body %>
    </main>
  </div>

  <%- partial('_partial/footer') %>

  <div class="search-overlay" id="searchOverlay" hidden>
    <div class="search-box">
      <div class="search-input-row">
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
          <circle cx="10.5" cy="10.5" r="6.5" fill="none" stroke="currentColor" stroke-width="2"/>
          <line x1="20" y1="20" x2="15.2" y2="15.2" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
        </svg>
        <input type="text" id="searchInput" placeholder="Search writeups, articles, cheatsheets..." autocomplete="off">
        <button id="searchClose" class="search-close" aria-label="Close search">&times;</button>
      </div>
      <div id="searchResults" class="search-results"></div>
    </div>
  </div>

  <script>
    window.BLACKICE = {
      root: "<%- config.root %>",
      clickEffect: <%- JSON.stringify(theme.click_effect || { enable: false }) %>,
      searchPath: "<%- url_for(theme.search_path || '/search.xml') %>"
    };
  </script>
  <script src="<%- url_for('/js/main.js') %>"></script>
  <script src="<%- url_for('/js/click-effect.js') %>"></script>
  <script src="<%- url_for('/js/search.js') %>"></script>
</body>
</html>
