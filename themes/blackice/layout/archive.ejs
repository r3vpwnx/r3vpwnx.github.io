<section class="archive">
  <h1 class="section-title">Archive</h1>
  <p class="section-sub"><%= site.posts.length %> posts total</p>

  <% var lastYear = null; %>
  <div class="timeline">
    <% page.posts.each(function(post){ %>
      <% var y = date(post.date, 'YYYY'); %>
      <% if (y !== lastYear) { lastYear = y; %>
        <div class="timeline-year"><span><%= y %></span></div>
      <% } %>
      <div class="timeline-item">
        <span class="timeline-dot"></span>
        <time class="timeline-date"><%= date(post.date, 'MM-DD') %></time>
        <a class="timeline-title" href="<%- url_for(post.path) %>"><%= post.title %></a>
        <% if (post.categories && post.categories.length) { %>
        <span class="timeline-cat">
          <% post.categories.forEach(function(cat, i){ %><%= i > 0 ? ', ' : '' %><%= cat.name %><% }) %>
        </span>
        <% } %>
      </div>
    <% }) %>
  </div>
</section>

<%- partial('_partial/pager') %>
